# ChainTrace environment configuration
# Copy to .env (root or backend/) and fill in real values. Never commit .env.

# Demo mode: true = use seeded demo blockchain data (no API keys required)
DEMO_MODE=true

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Database: local SQLite file (relative to the backend working directory)
DATABASE_PATH=./data/chaintrace.db

# Blockchain data providers
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=

# AI explanation via Groq (optional; deterministic template fallback if empty)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Python analysis service (optional; internal graph engine used if unavailable)
PYTHON_ANALYSIS_URL=http://127.0.0.1:5090